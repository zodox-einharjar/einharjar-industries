# Copy to .env.dev. Local development config — used by docker-compose.yml and backend/.env (symlink).
# Never point DATABASE_URL at the live database; refresh this DB with scripts/refresh_dev_db.sh.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DEBUG=true

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@192.168.1.132:5432/einharjar-industries_dev

# Separate EVE developer app for local use (callback http://localhost/auth/callback),
# so local token refreshes never touch the production app's tokens.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost/auth/callback

SDE_PATH=data/sqlite-latest.sqlite

# Discord deliberately unset: notifications are skipped and the bot isn't started locally.
